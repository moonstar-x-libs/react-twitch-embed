{
  "name": "react-twitch-embed",
  "version": "3.1.0",
  "description": "A collection of components to embed Twitch.",
  "scripts": {
    "storybook:serve": "storybook dev -p 6006",
    "storybook:build": "storybook build -o docs-build",
    "build": "vite build && tsc -p tsconfig.build.json && node ./scripts/build-esm-types.mjs",
    "build:watch": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:package": "publint",
    "test": "jest",
    "test:watch": "npm test -- --watch",
    "test:coverage": "npm test -- --coverage",
    "prepack": "npm run build"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "default": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "twitch",
    "twitch-embed",
    "twitch-stream",
    "twitch-player",
    "react-twitch"
  ],
  "license": "MIT",
  "author": "moonstar-x <christian.lopez99@outlook.com>",
  "homepage": "https://github.com/moonstar-x-libs/react-twitch-embed#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moonstar-x-libs/react-twitch-embed.git"
  },
  "bugs": {
    "url": "https://github.com/moonstar-x-libs/react-twitch-embed/issues"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.1",
    "@moonstar-x/eslint-config": "^2.0.0",
    "@moonstar-x/tsconfig": "^1.0.1",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-links": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-storybook": "^10.6.0",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.1",
    "publint": "^0.3.24",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remark-gfm": "^4.0.1",
    "storybook": "^10.6.0",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3",
    "vite": "^8.3.0"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20.19"
  },
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    },
    "@babel/plugin-transform-runtime": "^7.29.0"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true,
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
