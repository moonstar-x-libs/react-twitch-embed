{
  "name": "react-twitch-embed",
  "version": "3.1.0",
  "description": "A collection of components to embed Twitch.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:package": "publint"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "twitch",
    "twitch-embed",
    "twitch-stream",
    "twitch-player",
    "react-twitch"
  ],
  "license": "MIT",
  "author": "moonstar-x <christian.lopez99@outlook.com>",
  "homepage": "https://github.com/moonstar-x-libs/react-twitch-embed#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moonstar-x-libs/react-twitch-embed.git"
  },
  "bugs": {
    "url": "https://github.com/moonstar-x-libs/react-twitch-embed/issues"
  },
  "devDependencies": {
    "@moonstar-x/eslint-config": "^2.0.0",
    "@moonstar-x/tsconfig": "^1.0.1",
    "@types/node": "^26.5.1",
    "eslint": "^10.10.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-storybook": "^10.6.0",
    "publint": "^0.3.24",
    "typescript": "^6.0.3"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20.19"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  }
}
